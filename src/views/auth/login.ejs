<%
  pageTitle = 'ورود کاربران';
  extraCss = ['/css/shared/login-user.css', '/css/shared/login-admin.css'];
  headerTitle = pageTitle;
  showAppBar = false;
%>

<div class="page">
  <div class="card">
    <div class="topbar">
      <img class="logo" src="/icons/logo.png" alt="ToInfinity" />
      <div class="brand">
        <div class="name">ToInfinity</div>
        <div class="slogan">تا بینهایت برای بینهایت</div>
      </div>
    </div>

    <div class="badge"><span class="badge-dot"></span> ورود کاربران</div>
    <h1>ورود کاربران</h1>
    <p class="sub">لطفاً با نام کاربری و رمز عبور وارد شوید</p>

    <form method="POST" action="/login" autocomplete="on">
      <label for="username">نام کاربری <span class="req">*</span></label>
      <input id="username" name="username" type="text" placeholder="نام کاربری" required />

      <label for="password">رمز عبور <span class="req">*</span></label>
      <input id="password" name="password" type="password" placeholder="رمز عبور" required />

      <button class="btn" type="submit">ورود</button>
    </form>

    <a class="link" href="/register">ثبت نام</a>
  </div>
</div>
