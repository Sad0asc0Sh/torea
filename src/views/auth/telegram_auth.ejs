<%
  pageTitle = 'احراز تلگرام';
  extraCss = [];
  headerTitle = pageTitle;
%>

<%
  const __username = (typeof username !== 'undefined' && username) ? username : '';
  const __telegram_id = (typeof telegram_id !== 'undefined' && telegram_id) ? telegram_id : '';
  const __showStep1 = (typeof showStep1 !== 'undefined') ? !!showStep1 : false;
  const __canEditTelegramId = (typeof canEditTelegramId !== 'undefined') ? !!canEditTelegramId : false;
%>
<div class="card">
  <div style="display:flex;align-items:center;gap:.55rem;margin-bottom:1.1rem;">
    <img src="/icons/logo.png" alt="ToInfinity" style="height:34px;max-width:140px;display:block;">
    <span style="font-size:.95rem;font-weight:600;letter-spacing:.03em;">ToInfinity</span>
  </div>

  <div class="badge">
    <span class="badge-dot"></span>
    پنل داخلی BRIA – احراز تلگرام
  </div>

  <h1 class="card-title">اتصال حساب تلگرام به سامانه</h1>
  <p class="card-subtitle">
    برای فعال‌سازی حساب، ابتدا آیدی تلگرام خود را ثبت کنید تا کد برایتان ارسال شود، سپس کد ۶ رقمی را تایید کنید.
  </p>

  <% if (__username) { %>
    <div style="display:inline-flex;align-items:center;gap:.45rem;padding:.25rem .85rem;border-radius:999px;border:1px solid var(--card-border);background:var(--input-bg);font-size:.75rem;color:var(--muted);margin-bottom:1rem;">
      <span style="color:var(--text);font-weight:500;">@<%= __username %></span>
      <div>در حال احراز</div>
    </div>
  <% } %>

  <!-- بخش ۱: ارسال کد به تلگرام -->
  <% if (__showStep1) { %>
    <form method="post" action="/auth/telegram/send-code" class="form">
      <div style="border-radius:18px;border:1px solid var(--card-border);background:radial-gradient(circle at top right,var(--accent-soft),var(--bg-soft));padding:1rem .95rem .9rem;margin-bottom:1rem;">
        <div style="display:flex;align-items:center;gap:.45rem;margin-bottom:.75rem;">
          <div style="width:1.3rem;height:1.3rem;border-radius:999px;border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--muted);background:var(--input-bg);">۱</div>
          <div style="font-size:.82rem;font-weight:600;">ارسال کد احراز به تلگرام</div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>نام کاربری سیستم <span class="req">*</span></label>
            <div style="padding:.55rem .85rem;border:1px solid var(--card-border);border-radius:10px;background:var(--input-bg);color:var(--text);font-weight:500;line-height:1.6;word-break:break-all;">@<%= __username %></div>
            <input type="hidden" name="username" value="<%= __username %>">
            <div class="help-text">نام کاربری شما به صورت خودکار از سشن پر می‌شود.</div>
          </div>

          <div class="form-group">
            <label>آیدی تلگرام <span class="req">*</span></label>
            <input name="telegram_id" type="text" value="<%= __telegram_id %>" placeholder="مثلاً @your_telegram_id یا آیدی عددی" <%= __canEditTelegramId ? '' : 'readonly' %>>
            <div class="help-text">ربات، کد را به این آیدی در تلگرام ارسال می‌کند.</div>
          </div>
        </div>

        <div class="btn-group mt-2">
          <button type="submit" class="btn btn-secondary btn-block">ارسال کد به تلگرام</button>
        </div>
      </div>
    </form>
  <% } else { %>
    <form method="post" action="/auth/telegram/send-code" class="form">
      <div style="border-radius:18px;border:1px solid var(--card-border);background:radial-gradient(circle at top right,var(--accent-soft),var(--bg-soft));padding:1rem .95rem .9rem;margin-bottom:1rem;">
        <div style="display:flex;align-items:center;gap:.45rem;margin-bottom:.75rem;">
          <div style="width:1.3rem;height:1.3rem;border-radius:999px;border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--muted);background:var(--input-bg);">۱</div>
          <div style="font-size:.82rem;font-weight:600;">ارسال مجدد کد</div>
        </div>

        <input type="hidden" name="username" value="<%= __username %>">
        <div style="padding:.8rem;border:1px dashed var(--card-border);border-radius:12px;background:var(--input-bg);color:var(--muted);margin-bottom:1rem;">
          کد فقط به تلگرام ثبتشده شما ارسال میشود.
        </div>

        <div class="btn-group mt-2">
          <button type="submit" class="btn btn-secondary btn-block">ارسال مجدد کد</button>
        </div>
      </div>
    </form>
  <% } %>

  <!-- بخش ۲: تایید کد ۶ رقمی -->
  <form method="post" action="/auth/telegram/verify-code" class="form">
    <div style="border-radius:18px;border:1px solid var(--card-border);background:radial-gradient(circle at top right,var(--accent-soft),var(--bg-soft));padding:1rem .95rem .9rem;margin-bottom:1rem;">
      <div style="display:flex;align-items:center;gap:.45rem;margin-bottom:.75rem;">
        <div style="width:1.3rem;height:1.3rem;border-radius:999px;border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--muted);background:var(--input-bg);">۲</div>
        <div style="font-size:.82rem;font-weight:600;">تایید کد ۶ رقمی</div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label>نام کاربری سیستم <span class="req">*</span></label>
          <div style="padding:.55rem .85rem;border:1px solid var(--card-border);border-radius:10px;background:var(--input-bg);color:var(--text);font-weight:500;line-height:1.6;word-break:break-all;">@<%= __username %></div>
          <input type="hidden" name="username" value="<%= __username %>">
          <div class="help-text">نام کاربری از سشن احراز هویت خوانده می‌شود.</div>
        </div>

        <div class="form-group">
          <label>کد ۶ رقمی تلگرام <span class="req">*</span></label>
          <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" style="letter-spacing:.28em;text-align:center;font-weight:600;font-size:1rem;">
          <div class="help-text">آخرین کدی که ربات برای شما ارسال کرده را وارد کنید.</div>
        </div>
      </div>

      <div class="btn-group mt-2">
        <button type="submit" class="btn btn-primary btn-block">تایید کد و فعال‌سازی حساب</button>
      </div>
    </div>
  </form>

  <div style="margin-top:1.1rem;font-size:.72rem;color:var(--muted);text-align:center;line-height:1.8;">
    در صورت بروز مشکل در دریافت کد، آیدی تلگرام و اتصال خود به ربات را بررسی کنید یا با ادمین سیستم تماس بگیرید.
    <br>
    <a href="/login" class="btn btn-secondary" style="display:inline-block;margin-top:.8rem;min-width:0;padding:.45rem 1rem;font-size:.8rem;">
      بازگشت به صفحه ورود
    </a>
  </div>
</div>
