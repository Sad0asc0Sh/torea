<%
  pageTitle = 'در انتظار تأیید';
  extraCss = [];
  headerTitle = pageTitle;
%>

<%
  const __pendingUser = (typeof user !== 'undefined' && user) ? user : {};
  const __status = __pendingUser.status || '';
  const __isInactive = (__pendingUser.active === false);
  const __isPendingManager = (__status === 'pending_manager');
  const __message = __isPendingManager
    ? 'در انتظار تایید مدیر/ادمین'
    : (__isInactive ? 'حساب شما غیرفعال است' : '');
%>
<div class="card text-center">
  <div style="display:flex;align-items:center;justify-content:center;gap:.55rem;margin-bottom:1.5rem;">
    <img src="/icons/logo.png" alt="ToInfinity" style="height:34px;max-width:140px;display:block;">
    <span style="font-size:.95rem;font-weight:600;letter-spacing:.03em;">ToInfinity</span>
  </div>

  <div style="font-size:3rem;margin-bottom:1rem;">✅</div>

  <h1 class="card-title">ثبت‌نام شما تکمیل شد</h1>
  
  <p class="card-subtitle" style="font-size:0.95rem;">
    <strong style="color:var(--text-strong);"><%= (__pendingUser.first_name + ' ' + __pendingUser.last_name) || 'کاربر' %></strong> عزیز،
    <%= __message || 'وضعیت حساب شما در حال بررسی است.' %>
  </p>

  <div class="mt-3">
    <a href="/logout" class="btn btn-primary">رفتن به صفحه ورود</a>
  </div>
</div>
