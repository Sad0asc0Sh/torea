<%
  pageTitle = 'تأیید ورود';
  extraCss = ['/css/shared/login-admin.css'];
  headerTitle = pageTitle;
  showAppBar = false;
  adminTheme = true; // Enable admin theme
%>

<div class="page">
  <div class="card card-elevated auth-card">
    <!-- Brand Header -->
    <div class="auth-header">
      <img src="/icons/logo.png" alt="ToInfinity" class="auth-logo">
      <div class="auth-brand">
        <div class="auth-brand-name">ToInfinity</div>
        <div class="auth-brand-slogan">تا بینهایت برای بینهایت</div>
      </div>
    </div>

    <!-- Badge -->
    <div class="badge badge-accent">
      <span class="badge-dot"></span>
      تأیید ورود (کد تلگرام)
    </div>

    <!-- Title Section -->
    <div class="auth-title-section">
      <h1 class="auth-title">تأیید ورود</h1>
      <p class="auth-subtitle">کد ۶ رقمی ارسال‌شده را وارد کنید</p>
    </div>

    <!-- Form -->
    <form method="POST" action="/admin/verify" class="form auth-form">
      <div class="form-group">
        <label for="code" class="form-label form-label-required">کد تأیید</label>
        <input 
          id="code" 
          name="code" 
          type="text"
          class="form-input form-input-lg text-center" 
          inputmode="numeric" 
          autocomplete="one-time-code" 
          maxlength="6" 
          placeholder="------" 
          required 
          autofocus
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">تأیید و ورود</button>
    </form>

    <!-- Footer Link -->
    <div class="auth-footer">
      <a href="/admin/login" class="link-muted">بازگشت</a>
    </div>
  </div>
</div>
