<a href="<%= href %>" class="action-card">
  <div class="action-card-icon">
    <svg class="icon"><use href="/icons/icons.svg#icon-<%= icon %>"></use></svg>
  </div>
  <div class="action-card-content">
    <h3 class="action-card-title"><%= title %></h3>
    <p class="action-card-description"><%= description %></p>
  </div>
  <div class="action-card-arrow">
    <svg class="icon"><use href="/icons/icons.svg#icon-arrow"></use></svg>
  </div>
</a>
