<%
  const activeKey = 'reports';
  const pageTitle = 'گزارشات';
  const extraCss = ['/css/admin/admin-landing.css'];
  const pageClass = '';
  const tiles = [
    { icon: 'reports', label: 'مشاهده گزارشات', desc: 'لیست گزارشات فعال سیستم', href: '#list' },
  ];
%>

<%
var dbReports = (typeof dbReports !== 'undefined' && Array.isArray(dbReports)) ? dbReports : [];
var codeReports = (typeof codeReports !== 'undefined' && Array.isArray(codeReports)) ? codeReports : [];
var message = (typeof message !== 'undefined') ? message : '';
var error = (typeof error !== 'undefined') ? error : '';
%>

<div class="stack">
  <%- include('../../partials/admin_section_home', {
    title: 'گزارشات',
    subtitle: 'مرکز مدیریت کاتالوگ و ویجتها',
    tiles,
    backHref: '/admin/dashboard'
  }) %>

        <div class="card" style="margin-bottom: 1.5rem; padding: 1rem; background-color: #e8f4fd; border: 1px solid #b3d9f2;">
          <div style="display: flex; align-items: start; gap: 1rem;">
            <div style="font-size: 1.5rem;">📌</div>
            <div>
              <strong style="color: #0066cc;">یادآوری مهم:</strong>
              <p style="margin: 0.5rem 0;">برای مدیریت navigation گزارشات (اضافه/حذف/ترتیب)، از 
                <a href="/admin/settings/catalog-manager" style="color: #0066cc; text-decoration: underline;">مدیریت کاتالوگ</a> استفاده کنید.</p>
              <p style="margin: 0; color: #666;">این صفحه فقط لیست گزارشات فعال را نمایش میدهد.</p>
            </div>
          </div>
        </div>

        <section class="card" id="list">
          <div class="card-header">
            <div>
              <h2 class="card-title">کاتالوگ گزارشات</h2>
              <p class="card-subtitle">لیست گزارشات فعال در سیستم.</p>
            </div>
          </div>

          <div class="card-body">
            <div class="dashboard-stats">
              <div class="stat-card">
                <div class="stat-title">گزارشات فعال DB</div>
                <div class="stat-value"><%= (dbReports && dbReports.length) || 0 %></div>
              </div>
              <div class="stat-card">
                <div class="stat-title">گزارشات تعریف شده در کد</div>
                <div class="stat-value"><%= (codeReports && codeReports.length) || 0 %></div>
              </div>
            </div>

            <div class="table-wrapper">
              <table class="table">
                <thead>
                  <tr>
                    <th>کلید</th>
                    <th>عنوان</th>
                    <th>Scope</th>
                    <th>Order</th>
                    <th>Sources</th>
                  </tr>
                </thead>
                <tbody>
                  <% (dbReports || []).forEach(function(r){ %>
                    <tr>
                      <td><code><%= r.key %></code></td>
                      <td><%= r.title %></td>
                      <td><%= r.scope %></td>
                      <td><%= r.order_index %></td>
                      <td><%= (r.sources || []).join(', ') %></td>
                    </tr>
                  <% }); %>
                  <% if (!(dbReports || []).length) { %>
                    <tr><td colspan="5" class="muted">گزارشی در DB فعال نیست.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
