<%
  const activeKey = 'tools_training';
  const pageTitle = 'آموزش | ابزارهای مدیریت';
  const extraCss = ['/css/admin/tools/tools.css'];
  const pageClass = '';
%>

<%
var error = (typeof error !== 'undefined') ? error : '';
var telegramError = (typeof telegramError !== 'undefined') ? telegramError : '';
var info = (typeof info !== 'undefined') ? info : '';
var transcript = (typeof transcript !== 'undefined') ? transcript : '';
var speaker_match_score = (typeof speaker_match_score !== 'undefined') ? speaker_match_score : '';
var result = (typeof result !== 'undefined' && result) ? result : null;
var suspicious = (typeof suspicious !== 'undefined') ? suspicious : false;
%>

<div class="tools-page">
    <div class="page-container">
    <div class="actions" style="justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <div>
        <h1 style="margin: 0 0 6px;">دستیار آموزش</h1>
        <p style="margin: 0;">متن مکالمه را بفرستید تا وضعیت آموزش و خلاصه را ببینید.</p>
      </div>
      <a href="/admin/tools" class="pill">بازگشت به ابزارها</a>
    </div>

    <form method="POST" action="/admin/tools/training" class="card">
      <div style="margin-bottom: 14px;">
        <label for="transcript">متن مکالمه (برای پردازش فوری)</label>
        <textarea id="transcript" name="transcript" required placeholder="متن صوت را تایپ کنید یا اینجا بچسبانید"><%= transcript || '' %></textarea>
      </div>
      <div style="margin-bottom: 16px;">
        <label for="speaker_match_score">ضریب شباهت گوینده (۰ تا ۱) - صرفاً برای نشانه‌گذاری مشکوک</label>
        <input
          id="speaker_match_score"
          name="speaker_match_score"
          type="number"
          step="0.01"
          min="0"
          max="1"
          value="<%= speaker_match_score %>"
        />
        <p style="margin-top:6px; font-size:13px;">اگر کمتر از ۰.۵ باشد، برچسب «مشکوک» ثبت می‌شود ولی پردازش ادامه دارد.</p>
      </div>
      <button type="submit" class="btn-primary">ارسال برای آموزش</button>
    </form>

    <% if (result) { %>
      <div class="card">
        <div class="actions" style="justify-content: space-between; align-items: center;">
          <div style="font-weight:700;">نتیجه پردازش</div>
          <% if (suspicious) { %>
            <span class="badge warn">مشکوک</span>
          <% } %>
        </div>

        <% if (result.phase === 'baseline') { %>
          <div class="alert alert-ok" style="margin-top:12px;">سطح شما تعیین شد: <strong><%= result.difficulty_level === 'strict' ? 'سختگیرانه' : (result.difficulty_level === 'logical' ? 'منطقی' : 'ساده') %></strong></div>
          <p class="pill">برای ورود به فاز تمرین، نمونه‌های بیشتری ارسال کنید.</p>
        <% } else { %>
          <div class="result-grid" style="margin-top:12px;">
            <div class="pill">
              <div class="pill-label text-sm">فاز</div>
              <div class="text-bold"><%= result.phase === 'training' ? 'Training' : result.phase %></div>
            </div>
            <div class="pill">
              <div class="pill-label text-sm">سطح سختی</div>
              <div class="text-bold"><%= result.difficulty_level || '-' %></div>
            </div>
            <div class="pill">
              <div class="pill-label text-sm">موضوع فعلی</div>
              <div class="text-bold"><%= result.current_topic_key || '-' %></div>
            </div>
            <div class="pill">
              <div class="pill-label text-sm">امتیاز</div>
              <div class="text-bold"><%= result.score ?? '-' %></div>
            </div>
            <div class="pill">
              <div class="pill-label text-sm">میانگین متحرک</div>
              <div class="text-bold"><%= result.rolling_avg ?? '-' %></div>
            </div>
            <div class="pill">
              <div class="pill-label text-sm">حد آستانه</div>
              <div class="text-bold"><%= result.threshold ?? '-' %></div>
            </div>
          </div>

          <% if (result.outputs && result.outputs.summary_25) { %>
            <div class="pill" style="margin-top:12px; background:#f8fafc;">
              <div class="pill-label text-sm" style="margin-bottom:4px;">خلاصه ۲۵ کلمه‌ای</div>
              <div><%= result.outputs.summary_25 %></div>
            </div>
          <% } %>

          <% if (result.outputs && result.outputs.key_points && result.outputs.key_points.length) { %>
            <div class="pill" style="margin-top:12px; background:#f9f5ff;">
              <div class="pill-label text-sm" style="margin-bottom:6px;">نکات کلیدی</div>
              <ul class="key-points" style="padding-right:18px; margin:0;">
                <% result.outputs.key_points.forEach(function(kp){ %>
                  <li><%= kp %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } %>
    </div>
  </div>
