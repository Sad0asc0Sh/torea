<%
const activeKey = 'def_customer_industries';
  const pageTitle = mode === 'edit' ? 'ویرایش صنف مشتری' : 'افزودن صنف مشتری';
  const extraCss = ['/css/admin/definitions/customer-industries.css'];
  const pageClass = 'page--customer-industries';
%>
<%
  var __formAction = (typeof formAction !== 'undefined') ? formAction : '';
  var __industry = (typeof industry !== 'undefined') ? industry : {};
%>      <div class="stack">
        <section class="card">
          <div class="top">
            <div>
              <h2 class="title"><%= mode === 'edit' ? 'ویرایش صنف' : 'افزودن صنف جدید' %></h2>
              <p class="sub">عنوان، ترتیب نمایش و وضعیت فعال</p>
            </div>
            <div class="btn-row">
              <a class="btn btn-secondary" href="/admin/definitions/customer-industries">بازگشت</a>
            </div>
          </div>

          <form method="post" action="<%= __formAction %>" class="form-grid">
            <div class="field">
              <label for="title">عنوان صنف<span class="req">*</span></label>
              <input type="text" id="title" name="title" value="<%= __industry.title || '' %>" required>
            </div>

            <div class="field split">
              <div>
                <label for="sort_order">ترتیب نمایش</label>
                <input type="number" id="sort_order" name="sort_order" value="<%= typeof __industry.sort_order === 'number' ? __industry.sort_order : (__industry.sort_order || 0) %>" inputmode="numeric">
              </div>
              <div class="check-inline">
                <label for="is_active">فعال باشد؟</label>
                <input type="checkbox" id="is_active" name="is_active" <%= __industry.is_active !== false ? 'checked' : '' %> >
              </div>
            </div>

            <div class="actions-row">
              <button type="submit" class="btn btn-primary"><%= mode === 'edit' ? 'ذخیره تغییرات' : 'ثبت صنف' %></button>
              <a class="btn btn-secondary" href="/admin/definitions/customer-industries">انصراف</a>
            </div>
          </form>
        </section>
      </div>
