<%
  // User Layout - Standard Layout System
  // This file replaces the old user_layout.ejs partial system
  
  const __pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'ToInfinity';
  const __theme = (typeof theme !== 'undefined' && theme) ? theme : 'user';
  const __themeDisabled = !!(typeof themeDisabled !== 'undefined' && themeDisabled);
  const __scriptsDisabled = !!(typeof scriptsDisabled !== 'undefined' && scriptsDisabled);
  const __user = (typeof user !== 'undefined') ? user : null;
  const __error = (typeof error !== 'undefined' && error) ? error : null;
  const __warn = (typeof warn !== 'undefined' && warn) ? warn : null;
  const __info = (typeof info !== 'undefined' && info) ? info : null;
  const __extraCss = Array.isArray(extraCss) ? extraCss : (extraCss ? [extraCss] : []);
  const __pageClass = (typeof pageClass !== 'undefined' && pageClass) ? pageClass : '';
  const __headerTitle = (typeof headerTitle !== 'undefined' && headerTitle) ? headerTitle : __pageTitle;
  const __backHref = (typeof backHref !== 'undefined') ? backHref : null;
  const __backLabel = (typeof backLabel !== 'undefined' && backLabel) ? backLabel : 'بازگشت';
  const __showAppBar = (typeof showAppBar !== 'undefined') ? !!showAppBar : true;
  const __logoHref = (typeof logoHref !== 'undefined') ? logoHref : '/';
  const __showDrawer = false;
  const __activeKey = (typeof activeKey !== 'undefined' && activeKey) ? activeKey : '';
%>
<!doctype html>
<html lang="fa" dir="rtl" data-theme="<%= __theme %>">
<head>
  <meta charset="utf-8">
  <title><%= __pageTitle %> | ToInfinity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes">
  <meta name="theme-color" content="#0d6efd">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="ToInfinity">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="format-detection" content="telephone=no">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/logo.png" type="image/png">
  <link rel="apple-touch-icon" href="/icons/icon_180.png">
  <link rel="stylesheet" href="/css/app.css">
  <% __extraCss.forEach(function(href){ %>
    <link rel="stylesheet" href="<%= href %>">
  <% }) %>
</head>
<body class="theme-<%= __theme %> <%= __themeDisabled ? 'theme-disabled' : '' %> <%= __pageClass %>">
  <div class="mobile-app">
    <% if (__showAppBar) { %>
    <header class="app-bar">
      <div class="app-bar-left">
        <% if (__backHref) { %>
        <a href="<%= __backHref %>" class="btn-icon" aria-label="<%= __backLabel %>">
          <span>←</span>
        </a>
        <% } %>
      </div>
      <div class="app-bar-center">
        <% if (__logoHref) { %>
        <a class="app-bar-logo-link" href="<%= __logoHref %>" aria-label="خانه">
          <img src="/icons/logo.png" alt="ToInfinity" class="app-bar-logo">
        </a>
        <% } %>
        <span class="app-bar-title"><%= __headerTitle %></span>
      </div>
      <div class="app-bar-right"></div>
    </header>
    <% } %>

    <main class="app-content">
      <% if (__error) { %>
        <div class="alert alert-error"><%= __error %></div>
      <% } %>

      <% if (__warn) { %>
        <div class="alert alert-warn"><%= __warn %></div>
      <% } %>

      <% if (__info) { %>
        <div class="alert alert-info"><%= __info %></div>
      <% } %>
      
      <!-- Page Content (injected by child views via express-ejs-layouts) -->
      <%- body %>
      
    </main>

    <!-- Bottom Navigation (Mobile Only) -->
    <!-- User navigation: ابزارها، گزارشات، مانده، تأییدها -->
    <nav class="bottom-nav">
      <a href="/admin/tools/credit-sale" class="bottom-nav-item <%= __activeKey === 'tools' ? 'bottom-nav-item--active' : '' %>">
        <span class="bottom-nav-icon">
          <svg class="icon"><use href="/icons/icons.svg#icon-tools"></use></svg>
        </span>
        <span class="bottom-nav-label">ابزارها</span>
      </a>
      
      <a href="/admin/reports" class="bottom-nav-item <%= __activeKey === 'reports' ? 'bottom-nav-item--active' : '' %>">
        <span class="bottom-nav-icon">
          <svg class="icon"><use href="/icons/icons.svg#icon-reports"></use></svg>
        </span>
        <span class="bottom-nav-label">گزارشات</span>
      </a>
      
      <a href="/admin/tools/credit-settlement/inbox" class="bottom-nav-item <%= __activeKey === 'balance' ? 'bottom-nav-item--active' : '' %>">
        <span class="bottom-nav-icon">
          <svg class="icon"><use href="/icons/icons.svg#icon-balance"></use></svg>
        </span>
        <span class="bottom-nav-label">مانده</span>
      </a>
      
      <a href="/admin/tools/credit-sale/my-open" class="bottom-nav-item <%= __activeKey === 'approvals' ? 'bottom-nav-item--active' : '' %>">
        <span class="bottom-nav-icon">
          <svg class="icon"><use href="/icons/icons.svg#icon-approvals"></use></svg>
        </span>
        <span class="bottom-nav-label">تأییدها</span>
      </a>
    </nav>
  </div>

  <!-- Scripts: Load independently of theme -->
  <% if (__showDrawer && !__scriptsDisabled) { %>
  <script src="/js/mobile-ui.js"></script>
  <% } %>
  
  <% if (!__scriptsDisabled) { %>
  <script src="/js/ti-enhance.js"></script>
  <script src="/js/mobile-interactions.js"></script>
  <script src="/js/pwa-install.js"></script>
  <script src="/js/sw-update-notifier.js"></script>
  
  <script>
    // Register Service Worker
    window.addEventListener('load', function() {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').then(function(registration) {
          console.log('Service Worker registered:', registration.scope);
        }).catch(function(error) {
          console.log('Service Worker registration failed:', error);
        });
      }
    });
  </script>
  <% } %>
</body>
</html>
