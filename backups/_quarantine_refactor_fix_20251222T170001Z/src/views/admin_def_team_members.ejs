<%
  const __activeKey = 'def_teams';
  const __definitionsKeys = [
    'definitions',
    'def_teams',
    'def_brands',
    'def_products',
    'def_users',
    'credit_policy',
    'hierarchy',
    'hierarchy_arrange',
    'users'
  ];

  const __menuItems = [
    { title: 'داشبورد', href: '/admin/dashboard', active: __activeKey === 'dashboard' },
    {
      title: 'تعاریف',
      type: 'group',
      open: __definitionsKeys.includes(__activeKey),
      active: __definitionsKeys.includes(__activeKey),
      children: [
        { title: 'مرکز تعاریف', href: '/admin/definitions', active: __activeKey === 'definitions' },
        { title: 'تعریف تیم‌ها', href: '/admin/definitions/teams', active: __activeKey === 'def_teams' },
        { title: 'تعریف برندها', href: '/admin/definitions/brands', active: __activeKey === 'def_brands' },
        { title: 'تعریف کالاها', href: '/admin/definitions/products', active: __activeKey === 'def_products' },
        { title: 'سمت‌ها', href: '/admin/definitions/hierarchy', active: __activeKey === 'hierarchy' },
        { title: 'چیدمان سلسله مراتب', href: '/admin/definitions/hierarchy/arrange', active: __activeKey === 'hierarchy_arrange' },
        { title: 'کاربران', href: '/admin/users', active: __activeKey === 'users' },
      ],
    },
    {
      title: 'گزارشات',
      type: 'group',
      open: __activeKey === 'reports',
      active: __activeKey === 'reports',
      children: [
        { title: 'KPI و آمار', href: '/admin/reports', active: __activeKey === 'reports' },
      ],
    },
    {
      title: 'تأییدها',
      type: 'group',
      open: __activeKey === 'approvals',
      active: __activeKey === 'approvals',
      children: [
        { title: 'در انتظار تأیید', href: '/admin/approvals', active: __activeKey === 'approvals' },
      ],
    },
    { title: 'خروج', href: '/admin/logout', active: __activeKey === 'logout' },
  
  ,
  {
    group: 'ابزارها',
    items: [
      { label: 'دستیار من', href: '/admin/tools', icon: '🧰' }
    ]
  }

];
%>
<%
  const pageTitle = 'مدیریت اعضای تیم';
  const theme = 'admin';
  const themeDisabled = false;
  const menuItems = __menuItems;
  const userVal = (typeof user !== 'undefined' ? user : null);
  const errorMsg = (typeof error !== 'undefined' ? error : null);
  const warnMsg = (typeof warn !== 'undefined' ? warn : null);
  const infoMsg = (typeof info !== 'undefined' ? info : null);
  const extraCss = [];
  const pageClass = '';
  const __pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'ToInfinity';
  const __theme = (typeof theme !== 'undefined' && theme) ? theme : 'user';
  const __themeDisabled = !!(typeof themeDisabled !== 'undefined' && themeDisabled);
  const __isAdminTheme = __theme === 'admin';
  const __user = (typeof userVal !== 'undefined') ? userVal : null;
  const __basketsHref = '/admin/definitions/baskets';
  const __menu = (typeof menuItems !== 'undefined' && Array.isArray(menuItems)) ? menuItems : [];
  const __menuFiltered = __menu.map(function(item){
    if (item && Array.isArray(item.children)) {
      return {
        ...item,
        children: item.children.filter(function(child){ return child.href !== __basketsHref; })
      };
    }
    return item;
  }).filter(function(item){
    if (item && Array.isArray(item.children)) {
      return item.children.length > 0 || item.href !== __basketsHref;
    }
    return item && item.href !== __basketsHref;
  });
  const __showDrawer = __menuFiltered.length > 0;
  const __error = (typeof errorMsg !== 'undefined' && errorMsg) ? errorMsg : null;
  const __warn = (typeof warnMsg !== 'undefined' && warnMsg) ? warnMsg : null;
  const __info = (typeof infoMsg !== 'undefined' && infoMsg) ? infoMsg : null;
  const __extraCss = (typeof extraCss !== 'undefined' && extraCss) ? extraCss : [];
  const __userName = (__user && ([__user.first_name, __user.last_name].filter(Boolean).join(' ').trim() || __user.username || __user.name)) || null;
  const __pageClass = (typeof pageClass !== 'undefined' && pageClass) ? pageClass : '';
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <title><%= __pageTitle %> | ToInfinity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/logo.png" type="image/png">
  <% if (__isAdminTheme) { %>
    <link rel="preload" href="/fonts/vazir/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <% } %>
  
  <!-- Mobile-First CSS -->
  <% if (!__themeDisabled) { %>
    <link rel="stylesheet" href="/css/app-mobile.css?v=1">
    <% if (__isAdminTheme) { %>
      <link rel="stylesheet" href="/css/admin-ui.css">
    <% } %>
  <% } else { %>
  <% } %>
  <% __extraCss.forEach(function(href){ %>
    <link rel="stylesheet" href="<%= href %>">
  <% }) %>
</head>
<body data-skin="admin" class="theme-<%= __theme %> <%= __themeDisabled ? 'theme-disabled' : '' %> <%= __isAdminTheme ? 'admin-ui' : '' %> <%= __pageClass %>">
  <div class="mobile-app">
    <!-- App Bar -->
    <header class="app-bar">
      <div class="app-bar-left">
        <% if (__showDrawer) { %>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="منو">
          <span>☰</span>
        </button>
        <% } %>
      </div>
      
      <div class="app-bar-center <%= __isAdminTheme ? 'admin-brand' : '' %>">
        <a class="app-bar-logo-link" href="<%= __isAdminTheme ? '/admin/definitions' : '/' %>" aria-label="خانه">
          <img src="/icons/icon_1024.png" alt="ToInfinity" class="app-bar-logo">
        </a>
        <span class="app-bar-title">تا بینهایت</span>
      </div>
      
      <div class="app-bar-right"></div>
    </header>

    <% if (__showDrawer) { %>
    <div id="drawer-overlay" class="drawer-overlay"></div>
    
    <nav id="drawer" class="drawer">
      <div class="drawer-header">
        <h2 class="drawer-title">منو</h2>
        <button id="drawer-close" class="drawer-close" aria-label="بستن">×</button>
      </div>
      
      <div class="drawer-content">
         <ul class="drawer-menu">
           <% __menuFiltered.forEach(function(item) { %>
            <li class="drawer-menu-item">
              <% if (item && item.children && item.children.length) { %>
                <details class="drawer-details" <%= item.open ? 'open="open"' : '' %>>
                  <summary class="drawer-menu-link drawer-menu-summary <%= item.active ? 'active' : '' %>">
                    <span><%= item.title %></span>
                    <span class="drawer-menu-chevron" aria-hidden="true"></span>
                  </summary>
                  <ul class="drawer-submenu">
                    <% item.children.forEach(function(child) { %>
                      <li>
                        <a href="<%= child.href %>" class="drawer-menu-link <%= child.active ? 'active' : '' %>">
                          <span><%= child.title %></span>
                        </a>
                      </li>
                    <% }); %>
                  </ul>
                </details>
              <% } else if (item) { %>
                <a href="<%= item.href %>" class="drawer-menu-link <%= item.active ? 'active' : '' %>">
                  <span><%= item.title %></span>
                </a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
      
      <% if (__user) { %>
      <div class="drawer-footer">
        <div class="badge">
          <span class="badge-dot"></span>
          <span><%= __userName || 'کاربر' %></span>
        </div>
      </div>
      <% } %>
    </nav>
    <% } %>

    <!-- Main Content -->
    <main class="app-content <%= __isAdminTheme ? 'admin-main stack' : '' %>">
      <% if (__error) { %>
        <div class="alert alert-error"><%= __error %></div>
      <% } %>

      <% if (__warn) { %>
        <div class="alert alert-warn"><%= __warn %></div>
      <% } %>
      
      <% if (__info) { %>
        <div class="alert alert-info"><%= __info %></div>
      <% } %>
      
      <%
        const __team = team || {};
        const __members = Array.isArray(members) ? members : [];
      %>
      
      <div class="stack">
        <section class="card">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
            <div>
              <h2 style="margin:0 0 4px 0;font-size:16px;font-weight:900;">مسئولین و زیرمجموعه‌های تیم</h2>
              <p class="muted" style="margin:0;line-height:1.6;"><%= __team.name || 'تیم' %></p>
            </div>
            <div class="btn-row">
              <a class="btn btn-secondary" href="/admin/definitions/teams">بازگشت به لیست تیم‌ها</a>
              <a class="btn btn-secondary" href="/admin/definitions/teams/<%= __team.id %>/brands">مدیریت برندهای تیم</a>
            </div>
          </div>
      
          <% if (error) { %>
            <div class="alert alert-error" style="margin-top:10px;"><%= error %></div>
          <% } %>
          <% if (info) { %>
            <div class="alert alert-success" style="margin-top:10px;"><%= info %></div>
          <% } %>
        </section>
      
        <section class="card">
          <h3 style="margin:0 0 8px 0;font-size:15px;font-weight:900;">افزودن عضو جدید</h3>
          <p class="muted" style="margin:0 0 10px 0;">جستجو بر اساس نام کاربری، نام، نام خانوادگی یا تلفن.</p>
          <form id="member-search-form" class="form" style="margin-bottom:12px;display:flex;gap:10px;flex-wrap:wrap;">
            <input id="member-search-input" type="text" name="query" placeholder="عبارت جستجو..." style="flex:1;min-width:220px;" autocomplete="off" />
            <button id="member-search-btn" class="btn btn-primary" type="submit">جستجو</button>
          </form>
          <div id="member-search-status" class="muted">برای جستجو حداقل ۲ حرف وارد کنید.</div>
          <div id="member-search-results"></div>
        </section>
      
        <section class="card">
          <h3 style="margin:0 0 8px 0;font-size:15px;font-weight:900;">اعضای فعلی</h3>
          <% if (!__members.length) { %>
            <div class="alert alert-info">هنوز عضوی ثبت نشده است.</div>
          <% } else { %>
            <div class="table-shell table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>کاربر</th>
                    <th>تلفن</th>
                    <th>وضعیت</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% __members.forEach(function(m){ %>
                    <tr data-member-id="<%= m.user_id %>">
                      <td><%= m.username || '' %> - <%= (m.first_name || '') + ' ' + (m.last_name || '') %></td>
                      <td><%= m.phone || '—' %></td>
                      <td><%= m.active && m.status === 'active' ? 'فعال' : (m.status || '—') %></td>
                      <td>
                        <form method="post" action="/admin/definitions/teams/<%= __team.id %>/members/remove" style="display:inline;">
                          <input type="hidden" name="user_id" value="<%= m.user_id %>" />
                          <button class="btn btn-ghost btn-sm" type="submit">حذف</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      </div>
      
      <script>
      (() => {
        const teamId = <%- JSON.stringify(__team.id) %>;
        const memberIds = new Set(
          Array.from(document.querySelectorAll('[data-member-id]')).map((el) => String(el.getAttribute('data-member-id')))
        );
        const input = document.getElementById('member-search-input');
        const submitBtn = document.getElementById('member-search-btn');
        const statusEl = document.getElementById('member-search-status');
        const resultsEl = document.getElementById('member-search-results');
        let debounceTimer = null;
        let lastController = null;
      
        function setStatus(msg) {
          if (statusEl) statusEl.textContent = msg;
        }
      
        function renderCandidates(list) {
          const filtered = list.filter((u) => !memberIds.has(String(u.id)));
          if (!filtered.length) {
            resultsEl.innerHTML = '<div class="alert alert-info">کاربر فعالی با این مشخصات یافت نشد یا قبلاً عضو است.</div>';
            return;
          }
          const table = document.createElement('table');
          table.className = 'table';
          const thead = document.createElement('thead');
          thead.innerHTML = '<tr><th>کاربر</th><th>تلفن</th><th>وضعیت</th><th></th></tr>';
          table.appendChild(thead);
      
          const tbody = document.createElement('tbody');
          filtered.slice(0, 50).forEach((u) => {
            const tr = document.createElement('tr');
            const userTd = document.createElement('td');
            const fullName = [u.first_name, u.last_name].filter(Boolean).join(' ').trim();
            const displayParts = [u.username || '', fullName].filter((v) => v && v.trim() !== '');
            userTd.textContent = displayParts.join(' - ');
            tr.appendChild(userTd);
      
            const phoneTd = document.createElement('td');
            phoneTd.textContent = u.phone || '—';
            tr.appendChild(phoneTd);
      
            const statusTd = document.createElement('td');
            statusTd.textContent = u.active && u.status === 'active' ? 'فعال' : (u.status || '—');
            tr.appendChild(statusTd);
      
            const actionTd = document.createElement('td');
            const form = document.createElement('form');
            form.method = 'post';
            form.action = `/admin/definitions/teams/${teamId}/members/add`;
            form.style = 'display:flex;gap:6px;align-items:center;flex-wrap:wrap;';
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'user_id';
            hidden.value = u.id;
            form.appendChild(hidden);
            const button = document.createElement('button');
            button.className = 'btn btn-secondary btn-sm';
            button.type = 'submit';
            button.textContent = 'افزودن';
            form.appendChild(button);
            actionTd.appendChild(form);
            tr.appendChild(actionTd);
            tbody.appendChild(tr);
          });
      
          table.appendChild(tbody);
          const wrapper = document.createElement('div');
          wrapper.className = 'table-shell table-responsive';
          wrapper.appendChild(table);
          resultsEl.innerHTML = '';
          resultsEl.appendChild(wrapper);
        }
      
        async function fetchCandidates(q) {
          const query = (q || '').trim();
          if (!query || query.length < 2) {
            resultsEl.innerHTML = '';
            setStatus('برای جستجو حداقل ۲ حرف وارد کنید.');
            return;
          }
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(async () => {
            const started = performance.now();
            if (lastController) lastController.abort();
            lastController = new AbortController();
            setStatus('در حال جستجو...');
            try {
              const resp = await fetch(
                `/admin/definitions/teams/${teamId}/members/candidates?q=${encodeURIComponent(query)}`,
                { signal: lastController.signal }
              );
              if (!resp.ok) throw new Error('search_failed');
              const data = await resp.json();
              renderCandidates(Array.isArray(data.results) ? data.results : []);
              const duration = Math.round(performance.now() - started);
              setStatus(
                (data.results && data.results.length)
                  ? `نتایج (${Math.min(data.results.length, 50)}) - ${duration} میلی‌ثانیه`
                  : 'کاربر فعالی با این مشخصات یافت نشد یا قبلاً عضو است.'
              );
            } catch (err) {
              if (err.name === 'AbortError') return;
              setStatus('خطا در جستجو. لطفاً دوباره تلاش کنید.');
              resultsEl.innerHTML = '';
            }
          }, 250);
        }
      
        if (input && submitBtn) {
          submitBtn.addEventListener('click', (e) => {
            e.preventDefault();
            fetchCandidates(input.value);
          });
          input.addEventListener('input', (e) => fetchCandidates(e.target.value));
        }
      })();
      </script>
      
    </main>
  </div>

  <% if (!__themeDisabled && __showDrawer) { %>
  <script src="/js/mobile-ui.js"></script>
  <% } %>
  <% if (!__themeDisabled && __isAdminTheme) { %>
  <script defer src="/js/admin-ui.js"></script>
  <% } %>
  <script src="/js/ti-enhance.js"></script>
</body>
</html>
