<%
  const __activeKey = 'users';
  const __definitionsKeys = [
    'definitions',
    'def_teams',
    'def_brands',
    'def_products',
    'def_users',
    'credit_policy',
    'hierarchy',
    'hierarchy_arrange',
    'users'
  ];

  const __menuItems = [
    { title: 'داشبورد', href: '/admin/dashboard', active: __activeKey === 'dashboard' },
    {
      title: 'تعاریف',
      type: 'group',
      open: __definitionsKeys.includes(__activeKey),
      active: __definitionsKeys.includes(__activeKey),
      children: [
        { title: 'مرکز تعاریف', href: '/admin/definitions', active: __activeKey === 'definitions' },
        { title: 'تعریف تیم‌ها', href: '/admin/definitions/teams', active: __activeKey === 'def_teams' },
        { title: 'تعریف برندها', href: '/admin/definitions/brands', active: __activeKey === 'def_brands' },
        { title: 'تعریف کالاها', href: '/admin/definitions/products', active: __activeKey === 'def_products' },
        { title: 'سمت‌ها', href: '/admin/definitions/hierarchy', active: __activeKey === 'hierarchy' },
        { title: 'چیدمان سلسله مراتب', href: '/admin/definitions/hierarchy/arrange', active: __activeKey === 'hierarchy_arrange' },
        { title: 'کاربران', href: '/admin/users', active: __activeKey === 'users' },
      ],
    },
    {
      title: 'گزارشات',
      type: 'group',
      open: __activeKey === 'reports',
      active: __activeKey === 'reports',
      children: [
        { title: 'KPI و آمار', href: '/admin/reports', active: __activeKey === 'reports' },
      ],
    },
    {
      title: 'تأییدها',
      type: 'group',
      open: __activeKey === 'approvals',
      active: __activeKey === 'approvals',
      children: [
        { title: 'در انتظار تأیید', href: '/admin/approvals', active: __activeKey === 'approvals' },
      ],
    },
    { title: 'خروج', href: '/admin/logout', active: __activeKey === 'logout' },
  
  ,
  {
    group: 'ابزارها',
    items: [
      { label: 'دستیار من', href: '/admin/tools', icon: '🧰' }
    ]
  }

];
%>
<%
  const pageTitle = 'ویرایش کاربر';
  const theme = 'admin';
  const themeDisabled = false;
  const menuItems = __menuItems;
  const userVal = (typeof user !== 'undefined' ? user : null);
  const errorMsg = (typeof error !== 'undefined' ? error : null);
  const warnMsg = (typeof warn !== 'undefined' ? warn : null);
  const infoMsg = (typeof info !== 'undefined' ? info : null);
  const extraCss = [];
  const pageClass = '';
  const __pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'ToInfinity';
  const __theme = (typeof theme !== 'undefined' && theme) ? theme : 'user';
  const __themeDisabled = !!(typeof themeDisabled !== 'undefined' && themeDisabled);
  const __isAdminTheme = __theme === 'admin';
  const __user = (typeof userVal !== 'undefined') ? userVal : null;
  const __basketsHref = '/admin/definitions/baskets';
  const __menu = (typeof menuItems !== 'undefined' && Array.isArray(menuItems)) ? menuItems : [];
  const __menuFiltered = __menu.map(function(item){
    if (item && Array.isArray(item.children)) {
      return {
        ...item,
        children: item.children.filter(function(child){ return child.href !== __basketsHref; })
      };
    }
    return item;
  }).filter(function(item){
    if (item && Array.isArray(item.children)) {
      return item.children.length > 0 || item.href !== __basketsHref;
    }
    return item && item.href !== __basketsHref;
  });
  const __showDrawer = __menuFiltered.length > 0;
  const __error = (typeof errorMsg !== 'undefined' && errorMsg) ? errorMsg : null;
  const __warn = (typeof warnMsg !== 'undefined' && warnMsg) ? warnMsg : null;
  const __info = (typeof infoMsg !== 'undefined' && infoMsg) ? infoMsg : null;
  const __extraCss = (typeof extraCss !== 'undefined' && extraCss) ? extraCss : [];
  const __userName = (__user && ([__user.first_name, __user.last_name].filter(Boolean).join(' ').trim() || __user.username || __user.name)) || null;
  const __pageClass = (typeof pageClass !== 'undefined' && pageClass) ? pageClass : '';
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <title><%= __pageTitle %> | ToInfinity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/logo.png" type="image/png">
  <% if (__isAdminTheme) { %>
    <link rel="preload" href="/fonts/vazir/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <% } %>
  
  <!-- Mobile-First CSS -->
  <% if (!__themeDisabled) { %>
    <link rel="stylesheet" href="/css/app-mobile.css?v=1">
    <% if (__isAdminTheme) { %>
      <link rel="stylesheet" href="/css/admin-ui.css">
    <% } %>
  <% } else { %>
  <% } %>
  <% __extraCss.forEach(function(href){ %>
    <link rel="stylesheet" href="<%= href %>">
  <% }) %>
</head>
<body data-skin="admin" class="theme-<%= __theme %> <%= __themeDisabled ? 'theme-disabled' : '' %> <%= __isAdminTheme ? 'admin-ui' : '' %> <%= __pageClass %>">
  <div class="mobile-app">
    <!-- App Bar -->
    <header class="app-bar">
      <div class="app-bar-left">
        <% if (__showDrawer) { %>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="منو">
          <span>☰</span>
        </button>
        <% } %>
      </div>
      
      <div class="app-bar-center <%= __isAdminTheme ? 'admin-brand' : '' %>">
        <a class="app-bar-logo-link" href="<%= __isAdminTheme ? '/admin/definitions' : '/' %>" aria-label="خانه">
          <img src="/icons/icon_1024.png" alt="ToInfinity" class="app-bar-logo">
        </a>
        <span class="app-bar-title">تا بینهایت</span>
      </div>
      
      <div class="app-bar-right"></div>
    </header>

    <% if (__showDrawer) { %>
    <div id="drawer-overlay" class="drawer-overlay"></div>
    
    <nav id="drawer" class="drawer">
      <div class="drawer-header">
        <h2 class="drawer-title">منو</h2>
        <button id="drawer-close" class="drawer-close" aria-label="بستن">×</button>
      </div>
      
      <div class="drawer-content">
         <ul class="drawer-menu">
           <% __menuFiltered.forEach(function(item) { %>
            <li class="drawer-menu-item">
              <% if (item && item.children && item.children.length) { %>
                <details class="drawer-details" <%= item.open ? 'open="open"' : '' %>>
                  <summary class="drawer-menu-link drawer-menu-summary <%= item.active ? 'active' : '' %>">
                    <span><%= item.title %></span>
                    <span class="drawer-menu-chevron" aria-hidden="true"></span>
                  </summary>
                  <ul class="drawer-submenu">
                    <% item.children.forEach(function(child) { %>
                      <li>
                        <a href="<%= child.href %>" class="drawer-menu-link <%= child.active ? 'active' : '' %>">
                          <span><%= child.title %></span>
                        </a>
                      </li>
                    <% }); %>
                  </ul>
                </details>
              <% } else if (item) { %>
                <a href="<%= item.href %>" class="drawer-menu-link <%= item.active ? 'active' : '' %>">
                  <span><%= item.title %></span>
                </a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
      
      <% if (__user) { %>
      <div class="drawer-footer">
        <div class="badge">
          <span class="badge-dot"></span>
          <span><%= __userName || 'کاربر' %></span>
        </div>
      </div>
      <% } %>
    </nav>
    <% } %>

    <!-- Main Content -->
    <main class="app-content <%= __isAdminTheme ? 'admin-main stack' : '' %>">
      <% if (__error) { %>
        <div class="alert alert-error"><%= __error %></div>
      <% } %>

      <% if (__warn) { %>
        <div class="alert alert-warn"><%= __warn %></div>
      <% } %>
      
      <% if (__info) { %>
        <div class="alert alert-info"><%= __info %></div>
      <% } %>
      
      <%
      // ==== PATCH_LOCK_SYSTEM_SUPERADMIN_USEREDIT_V1 ====
      // هدف:
      // 1) user SYSTEM / general_manager -> فرم قفل (هیچ تغییر)
      // 2) SUPER_ADMIN -> فیلدهای org_node_id و manager_id نمایش داده نشوند و قابل تغییر نباشند
      // 3) orgNodes های branch=SYSTEM در dropdown ها نیاید
      
      const __editUser =
        (typeof editUser !== 'undefined' ? editUser :
        (typeof userToEdit !== 'undefined' ? userToEdit :
        (typeof targetUser !== 'undefined' ? targetUser :
        (typeof u !== 'undefined' ? u :
        (typeof user_edit !== 'undefined' ? user_edit :
        (typeof user !== 'undefined' ? user : null))))));
      
      const __editRole = (__editUser && __editUser.role) ? String(__editUser.role).toUpperCase() : '';
      const __editUsername = (__editUser && __editUser.username) ? String(__editUser.username).toLowerCase() : '';
      
      const __isSuperAdmin = false;
      
      function __notSystemNode(n){
        try { return String((n && n.branch) ? n.branch : 'ORG').toUpperCase() !== 'SYSTEM'; }
        catch(e){ return true; }
      }
      function __notProtectedUserJs(u){
        try {
          const r = String((u && u.role) ? u.role : '').toUpperCase();
          const un = String((u && u.username) ? u.username : '').toLowerCase();
          return (r !== 'SYSTEM' && r !== 'SUPER_ADMIN' && un !== 'admin' && un !== 'general_manager');
        } catch(e){ return true; }
      }
      
      if (typeof orgNodes !== 'undefined' && Array.isArray(orgNodes)) orgNodes = orgNodes.filter(__notSystemNode);
      if (typeof nodes !== 'undefined' && Array.isArray(nodes)) nodes = nodes.filter(__notSystemNode);
      if (typeof managers !== 'undefined' && Array.isArray(managers)) managers = managers.filter(__notProtectedUserJs);
      %>
      
      <div class="stack">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
      
        <section class="card">
          <h2 style="margin:0 0 12px 0;font-size:15px;font-weight:900;">ویرایش کاربر (ID: <%= user.id %>)</h2>
      
          <form class="form" method="post" action="/admin/users/<%= user.id %>/edit">
            <div class="grid-2">
              <div class="field">
                <label for="first_name">نام</label>
                <input id="first_name" name="first_name" value="<%= user.first_name || '' %>" required />
              </div>
      
              <div class="field">
                <label for="last_name">نام خانوادگی</label>
                <input id="last_name" name="last_name" value="<%= user.last_name || '' %>" required />
              </div>
            </div>
      
            <div class="grid-2">
              <div class="field">
                <label for="phone">شماره همراه</label>
                <input id="phone" name="phone" value="<%= user.phone || '' %>" required />
              </div>
      
              <div class="field">
                <label for="telegram_id">آیدی تلگرام</label>
                <input id="telegram_id" name="telegram_id" value="<%= user.telegram_id || '' %>" />
              </div>
            </div>
      
            <div class="grid-2">
              <div class="field">
                <label for="username">نام کاربری</label>
                <input id="username" name="username" value="<%= user.username || '' %>" required />
              </div>
      
              <div class="field">
                <label for="role">نقش کاربر</label>
                <select id="role" name="role">
                  <option value="USER" <%= user.role === 'USER' ? 'selected' : '' %>>USER</option>
                </select>
              </div>
            </div>
      
            <div class="field">
              <% if (!__isSuperAdmin) { %>
      <div style="display:none">
                <label for="org_node_id" style="display:none"> سمت سازمانی </label>
      </div>
                <select id="org_node_id" name="org_node_id" required style="display:none">
                  <option value="">انتخاب کنید...</option>
                  <% (orgNodes || []).forEach(function (n) { %>
                    <% if ((n.title === 'شرکت' || n.title === 'ادمین شرکت') && user.role !== 'ADMIN') { return; } %>
                    <option value="<%= n.id %>" <%= String(user.org_node_id || '') === String(n.id) ? 'selected' : '' %>>
                      <%= n.title %>
                    </option>
                  <% }); %>
                </select>
              <% } else { %>
                <input type="hidden" name="org_node_id" value="<%= user.org_node_id %>">
              <% } %>
      
              <div class="hint">سمت کاربر در ساختار سلسله‌مراتب.</div>
            </div>
      
            <div class="field">
              <label>
                <input type="checkbox" name="active" <%= user.active ? 'checked' : '' %> />
                فعال باشد
              </label>
              <div class="hint">اگر کاربر در وضعیت pending_manager باشد، با فعال کردن این گزینه تایید نهایی انجام میشود.</div>
            </div>
      
            <div class="field">
              <label for="password">رمز عبور جدید (در صورت نیاز)</label>
              <input id="password" name="password" type="password" />
              <div class="hint">در صورت خالی‌گذاشتن، رمز عبور فعلی تغییری نمی‌کند.</div>
            </div>
      
            <div class="btn-row">
              <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
              <a class="btn btn-secondary" href="/admin/users">بازگشت</a>
            </div>
          </form>
        </section>
      </div>
      
      <script>
      // UI lock (final safety)
      // - SUPER_ADMIN: hide & disable org_node_id + manager_id fields
      // - SYSTEM/general_manager: disable whole form submit/inputs
      window.addEventListener('DOMContentLoaded', function(){
        const editRole = <%- JSON.stringify(__editRole || "") %>;
        const editUsername = <%- JSON.stringify(__editUsername || "") %>;
        const isSystem = (editRole === "SYSTEM" || editUsername === "general_manager");
        const isSuper = (editRole === "SUPER_ADMIN" || editUsername === "admin");
      
        function hideFieldByName(name){
          document.querySelectorAll('[name="'+name+'"]').forEach(function(el){
            try {
              el.disabled = true;
              const box = el.closest('.form-group') || el.closest('.mb-3') || el.closest('.field') || el.closest('div') || el;
              box.style.display = 'none';
            } catch(e){}
          });
        }
      
        if (isSuper){
          hideFieldByName('org_node_id');
          hideFieldByName('manager_id');
        }
      
        if (isSystem){
          document.querySelectorAll('.admin-main input,.admin-main select,.admin-main textarea,.admin-main button').forEach(function(el){
            try { el.disabled = true; } catch(e){}
          });
          document.querySelectorAll('.admin-main button[type="submit"],.admin-main input[type="submit"]').forEach(function(el){
            try { el.style.display = 'none'; } catch(e){}
          });
      
          const notice = document.createElement('div');
          notice.className = 'alert';
          notice.style.borderColor = 'rgba(245,158,11,.35)';
          notice.style.background = 'rgba(245,158,11,.12)';
          notice.innerText = 'این کاربر/رکورد سیستمی است و در نصب ساخته شده؛ ویرایش آن مجاز نیست.';
      
          const main = document.querySelector('.admin-main');
          if (main) main.prepend(notice);
        }
      });
      </script>
      
    </main>
  </div>

  <% if (!__themeDisabled && __showDrawer) { %>
  <script src="/js/mobile-ui.js"></script>
  <% } %>
  <% if (!__themeDisabled && __isAdminTheme) { %>
  <script defer src="/js/admin-ui.js"></script>
  <% } %>
  <script src="/js/ti-enhance.js"></script>
</body>
</html>
