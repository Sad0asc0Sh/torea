<%
  const __activeKey = 'def_products';
  const __definitionsKeys = [
    'definitions',
    'def_teams',
    'def_brands',
    'def_products',
    'def_users',
    'credit_policy',
    'hierarchy',
    'hierarchy_arrange',
    'users'
  ];

  const __menuItems = [
    { title: 'داشبورد', href: '/admin/dashboard', active: __activeKey === 'dashboard' },
    {
      title: 'تعاریف',
      type: 'group',
      open: __definitionsKeys.includes(__activeKey),
      active: __definitionsKeys.includes(__activeKey),
      children: [
        { title: 'مرکز تعاریف', href: '/admin/definitions', active: __activeKey === 'definitions' },
        { title: 'تعریف تیم‌ها', href: '/admin/definitions/teams', active: __activeKey === 'def_teams' },
        { title: 'تعریف برندها', href: '/admin/definitions/brands', active: __activeKey === 'def_brands' },
        { title: 'تعریف کالاها', href: '/admin/definitions/products', active: __activeKey === 'def_products' },
        { title: 'سمت‌ها', href: '/admin/definitions/hierarchy', active: __activeKey === 'hierarchy' },
        { title: 'چیدمان سلسله مراتب', href: '/admin/definitions/hierarchy/arrange', active: __activeKey === 'hierarchy_arrange' },
        { title: 'کاربران', href: '/admin/users', active: __activeKey === 'users' },
      ],
    },
    {
      title: 'گزارشات',
      type: 'group',
      open: __activeKey === 'reports',
      active: __activeKey === 'reports',
      children: [
        { title: 'KPI و آمار', href: '/admin/reports', active: __activeKey === 'reports' },
      ],
    },
    {
      title: 'تأییدها',
      type: 'group',
      open: __activeKey === 'approvals',
      active: __activeKey === 'approvals',
      children: [
        { title: 'در انتظار تأیید', href: '/admin/approvals', active: __activeKey === 'approvals' },
      ],
    },
    { title: 'خروج', href: '/admin/logout', active: __activeKey === 'logout' },
  
  ,
  {
    group: 'ابزارها',
    items: [
      { label: 'دستیار من', href: '/admin/tools', icon: '🧰' }
    ]
  }

];
%>
<%
  const pageTitle = 'تعریف کالاها';
  const theme = 'admin';
  const themeDisabled = false;
  const menuItems = __menuItems;
  const userVal = (typeof user !== 'undefined' ? user : null);
  const errorMsg = (typeof error !== 'undefined' ? error : null);
  const warnMsg = (typeof warn !== 'undefined' ? warn : null);
  const infoMsg = (typeof info !== 'undefined' ? info : null);
  const extraCss = [];
  const pageClass = '';
  const __pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'ToInfinity';
  const __theme = (typeof theme !== 'undefined' && theme) ? theme : 'user';
  const __themeDisabled = !!(typeof themeDisabled !== 'undefined' && themeDisabled);
  const __isAdminTheme = __theme === 'admin';
  const __user = (typeof userVal !== 'undefined') ? userVal : null;
  const __basketsHref = '/admin/definitions/baskets';
  const __menu = (typeof menuItems !== 'undefined' && Array.isArray(menuItems)) ? menuItems : [];
  const __menuFiltered = __menu.map(function(item){
    if (item && Array.isArray(item.children)) {
      return {
        ...item,
        children: item.children.filter(function(child){ return child.href !== __basketsHref; })
      };
    }
    return item;
  }).filter(function(item){
    if (item && Array.isArray(item.children)) {
      return item.children.length > 0 || item.href !== __basketsHref;
    }
    return item && item.href !== __basketsHref;
  });
  const __showDrawer = __menuFiltered.length > 0;
  const __error = (typeof errorMsg !== 'undefined' && errorMsg) ? errorMsg : null;
  const __warn = (typeof warnMsg !== 'undefined' && warnMsg) ? warnMsg : null;
  const __info = (typeof infoMsg !== 'undefined' && infoMsg) ? infoMsg : null;
  const __extraCss = (typeof extraCss !== 'undefined' && extraCss) ? extraCss : [];
  const __userName = (__user && ([__user.first_name, __user.last_name].filter(Boolean).join(' ').trim() || __user.username || __user.name)) || null;
  const __pageClass = (typeof pageClass !== 'undefined' && pageClass) ? pageClass : '';
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <title><%= __pageTitle %> | ToInfinity</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/logo.png" type="image/png">
  <% if (__isAdminTheme) { %>
    <link rel="preload" href="/fonts/vazir/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <% } %>
  
  <!-- Mobile-First CSS -->
  <% if (!__themeDisabled) { %>
    <link rel="stylesheet" href="/css/app-mobile.css?v=1">
    <% if (__isAdminTheme) { %>
      <link rel="stylesheet" href="/css/admin-ui.css">
    <% } %>
  <% } else { %>
  <% } %>
  <% __extraCss.forEach(function(href){ %>
    <link rel="stylesheet" href="<%= href %>">
  <% }) %>
</head>
<body class="theme-<%= __theme %> <%= __themeDisabled ? 'theme-disabled' : '' %> <%= __isAdminTheme ? 'admin-ui' : '' %> <%= __pageClass %>">
  <div class="mobile-app">
    <!-- App Bar -->
    <header class="app-bar">
      <div class="app-bar-left">
        <% if (__showDrawer) { %>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="منو">
          <span>☰</span>
        </button>
        <% } %>
      </div>
      
      <div class="app-bar-center <%= __isAdminTheme ? 'admin-brand' : '' %>">
        <a class="app-bar-logo-link" href="<%= __isAdminTheme ? '/admin/definitions' : '/' %>" aria-label="خانه">
          <img src="/icons/icon_1024.png" alt="ToInfinity" class="app-bar-logo">
        </a>
        <span class="app-bar-title">تا بینهایت</span>
      </div>
      
      <div class="app-bar-right"></div>
    </header>

    <% if (__showDrawer) { %>
    <div id="drawer-overlay" class="drawer-overlay"></div>
    
    <nav id="drawer" class="drawer">
      <div class="drawer-header">
        <h2 class="drawer-title">منو</h2>
        <button id="drawer-close" class="drawer-close" aria-label="بستن">×</button>
      </div>
      
      <div class="drawer-content">
         <ul class="drawer-menu">
           <% __menuFiltered.forEach(function(item) { %>
            <li class="drawer-menu-item">
              <% if (item && item.children && item.children.length) { %>
                <details class="drawer-details" <%= item.open ? 'open="open"' : '' %>>
                  <summary class="drawer-menu-link drawer-menu-summary <%= item.active ? 'active' : '' %>">
                    <span><%= item.title %></span>
                    <span class="drawer-menu-chevron" aria-hidden="true"></span>
                  </summary>
                  <ul class="drawer-submenu">
                    <% item.children.forEach(function(child) { %>
                      <li>
                        <a href="<%= child.href %>" class="drawer-menu-link <%= child.active ? 'active' : '' %>">
                          <span><%= child.title %></span>
                        </a>
                      </li>
                    <% }); %>
                  </ul>
                </details>
              <% } else if (item) { %>
                <a href="<%= item.href %>" class="drawer-menu-link <%= item.active ? 'active' : '' %>">
                  <span><%= item.title %></span>
                </a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
      
      <% if (__user) { %>
      <div class="drawer-footer">
        <div class="badge">
          <span class="badge-dot"></span>
          <span><%= __userName || 'کاربر' %></span>
        </div>
      </div>
      <% } %>
    </nav>
    <% } %>

    <!-- Main Content -->
    <main class="app-content <%= __isAdminTheme ? 'admin-main stack' : '' %>">
      <% if (__error) { %>
        <div class="alert alert-error"><%= __error %></div>
      <% } %>

      <% if (__warn) { %>
        <div class="alert alert-warn"><%= __warn %></div>
      <% } %>
      
      <% if (__info) { %>
        <div class="alert alert-info"><%= __info %></div>
      <% } %>
      
      <%
        const __products = Array.isArray(products) ? products : [];
        const __brands = Array.isArray(brands) ? brands : [];
        const currentBrandId = filterBrandId ? Number(filterBrandId) : null;
        const totalPagesSafe = totalPages && totalPages > 0 ? totalPages : 1;
      
        function buildPageHref(p) {
          const qs = new URLSearchParams();
          if (currentBrandId) qs.set('brand_id', currentBrandId);
          if (searchQuery) qs.set('q', searchQuery);
          qs.set('page', p);
          return '/admin/definitions/products?' + qs.toString();
        }
      
        function formatAliases(aliases) {
          if (Array.isArray(aliases)) return aliases.join(', ') || '—';
          return aliases || '—';
        }
      %>
      
      <div class="stack">
        <section class="card">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
            <div>
              <h2 style="margin:0 0 4px 0;font-size:16px;font-weight:900;">تعریف کالاها</h2>
              <p class="muted" style="margin:0;line-height:1.6;">لیست کالاها همراه با برند، وضعیت و جست‌وجو/فیلتر.</p>
            </div>
            <div class="btn-row" style="flex-wrap:wrap;gap:6px;">
              <a class="btn btn-primary" href="/admin/definitions/products/new">افزودن کالا</a>
              <a class="btn btn-secondary" href="/admin/definitions/products/template.xlsx">دانلود قالب اکسل</a>
              <details style="margin:0;">
                <summary class="btn btn-secondary" style="cursor:pointer;list-style:none;">ورود از اکسل</summary>
                <form action="/admin/definitions/products/import" method="post" enctype="multipart/form-data" style="display:flex;gap:6px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                  <input type="file" name="file" accept=".xlsx" required style="max-width:200px;" />
                  <button class="btn btn-ghost" type="submit">بارگذاری</button>
                </form>
              </details>
              <a class="btn btn-secondary" href="/admin/definitions">بازگشت</a>
            </div>
          </div>
      
          <form method="get" action="/admin/definitions/products" class="form" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
            <div class="form-group" style="min-width:160px;">
              <label for="brand_id">برند</label>
              <select id="brand_id" name="brand_id">
                <option value="">همه برندها</option>
                <% __brands.forEach(function(b){ %>
                  <option value="<%= b.id %>" <%= currentBrandId === Number(b.id) ? 'selected' : '' %>>
                    <%= b.name %><%= b.is_active === false ? ' (غیرفعال)' : '' %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="form-group" style="flex:1;min-width:200px;">
              <label for="q">جست‌وجو (کد یا نام کالا)</label>
              <input id="q" name="q" type="text" value="<%= searchQuery || '' %>" placeholder="مثال: ACME-001 یا نوشابه" />
            </div>
            <button class="btn btn-secondary" type="submit">اعمال فیلتر</button>
          </form>
          <% if (!__brands.length) { %>
            <div class="alert alert-info" style="margin-top:10px;">اول برند بسازید.</div>
          <% } %>
      
          <% if (__error) { %>
            <div class="alert alert-error" style="margin-top:10px;"><%= __error %></div>
          <% } %>
          <% if (__warn) { %>
            <div class="alert alert-info" style="margin-top:10px;"><%= __warn %></div>
          <% } %>
          <% if (__info) { %>
            <div class="alert alert-success" style="margin-top:10px;"><%= __info %></div>
          <% } %>
          <% if (importResult) { %>
            <div class="alert <%= importResult.failed ? 'alert-info' : 'alert-success' %>" style="margin-top:10px;">
              <strong>نتیجه ورود اکسل</strong>
              <div style="margin-top:4px;">
                <span>کل: <%= importResult.totalRows || 0 %></span>
                <span style="margin-right:8px;">درج: <%= importResult.inserted || 0 %></span>
                <span style="margin-right:8px;">به‌روزرسانی: <%= importResult.updated || 0 %></span>
                <span style="margin-right:8px;">خطا: <%= importResult.failed || 0 %></span>
              </div>
              <% if (importResult.errors && importResult.errors.length) { %>
                 <div class="table-shell table-responsive" style="margin-top:8px;">
                   <table class="table">
                     <thead><tr><th>ردیف</th><th>پیام خطا</th></tr></thead>
                    <tbody>
                      <% importResult.errors.forEach(function(e){ %>
                        <tr>
                          <td class="mono"><%= e.row %></td>
                          <td><%= e.message %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                  <p class="muted" style="margin:4px 0 0 0;">حداکثر <%= importResult.errors.length %> خطای اول نمایش داده می‌شود.</p>
                </div>
              <% } %>
            </div>
          <% } %>
      
           <div class="table-shell table-responsive product-table-wrap">
            <table class="table product-table">
              <thead>
                <tr>
                  <th>کالا</th>
                  <th>برند</th>
                  <th>کد SKU</th>
                  <th>وضعیت</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!__products.length) { %>
                  <tr>
                    <td colspan="5" style="text-align:center;">کالایی ثبت نشده است.</td>
                  </tr>
                <% } else { %>
                  <% __products.forEach(function(p){ %>
                    <tr>
                      <td>
                        <div style="display:flex;flex-direction:column;gap:4px;">
                          <strong><%= p.name %></strong>
                          <details class="product-details">
                            <summary>جزئیات</summary>
                            <div class="muted" style="margin-top:6px;">برچسب‌ها: <%= formatAliases(p.aliases) %></div>
                            <div style="margin-top:4px;">
                              <% if (p.is_key) { %>
                                <span class="pill pill-ok">کالای کلیدی</span>
                              <% } else { %>
                                <span class="pill pill-muted">غیرکلیدی</span>
                              <% } %>
                            </div>
                          </details>
                        </div>
                      </td>
                      <td>
                        <%= p.brand_name || '—' %>
                        <% if (p.brand_is_active === false) { %>
                          <span class="pill pill-bad" style="margin-right:4px;">غیرفعال</span>
                        <% } %>
                      </td>
                      <td class="mono"><%= p.sku_code || '—' %></td>
                      <td>
                        <% if (p.is_active) { %>
                          <span class="pill pill-ok">فعال</span>
                        <% } else { %>
                          <span class="pill pill-bad">غیرفعال</span>
                        <% } %>
                      </td>
                      <td style="white-space:nowrap;display:flex;gap:6px;flex-wrap:wrap;">
                        <a class="btn btn-secondary btn-sm" href="/admin/definitions/products/<%= p.id %>/edit">ویرایش</a>
                        <form method="post" action="/admin/definitions/products/<%= p.id %>/toggle" style="display:inline;">
                          <button class="btn btn-ghost btn-sm" type="submit"><%= p.is_active ? 'غیرفعال' : 'فعال' %> کردن</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
      
          <% if (totalPagesSafe > 1) { %>
            <div class="pager" style="display:flex;gap:8px;justify-content:flex-end;align-items:center;margin-top:10px;">
              <span class="muted">صفحه <%= page %> از <%= totalPagesSafe %></span>
              <div class="btn-row">
                <% if (page > 1) { %>
                  <a class="btn btn-secondary btn-sm" href="<%= buildPageHref(page - 1) %>">قبلی</a>
                <% } else { %>
                  <button class="btn btn-secondary btn-sm" disabled>قبلی</button>
                <% } %>
                <% if (page < totalPagesSafe) { %>
                  <a class="btn btn-secondary btn-sm" href="<%= buildPageHref(page + 1) %>">بعدی</a>
                <% } else { %>
                  <button class="btn btn-secondary btn-sm" disabled>بعدی</button>
                <% } %>
              </div>
            </div>
          <% } %>
        </section>
      </div>
      
    </main>
  </div>

  <% if (!__themeDisabled && __showDrawer) { %>
  <script src="/js/mobile-ui.js"></script>
  <% } %>
  <% if (!__themeDisabled && __isAdminTheme) { %>
  <script defer src="/js/admin-ui.js"></script>
  <% } %>
  <script src="/js/ti-enhance.js"></script>
</body>
</html>
