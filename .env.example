# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/toinfinity

# Session Secret
SESSION_SECRET=your-secret-key-here

# Theme Settings
# Set to true to disable theme CSS (rarely used)
THEME_DISABLED=false

# Scripts Settings
# Set to true to disable JavaScript (not recommended - breaks functionality)
SCRIPTS_DISABLED=false

# Server Configuration
PORT=3000
NODE_ENV=development

# Cron Jobs Configuration
ENABLE_CRON_JOBS=true
TZ=Asia/Tehran
